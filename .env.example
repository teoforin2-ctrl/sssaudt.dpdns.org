# x-reviewer local ports — chosen to avoid common collisions
# Busy on this machine historically: 3000,3001,4000,5432,5433,6379,6380,8000,8080
COMPOSE_PROJECT_NAME=xreviewer

WEB_PORT=3710
DASHBOARD_PORT=3711
API_PORT=3712
POSTGRES_PORT=5435
REDIS_PORT=6382

# Postgres
POSTGRES_USER=xreviewer
POSTGRES_PASSWORD=xreviewer
POSTGRES_DB=xreviewer
DATABASE_URL=postgresql://xreviewer:xreviewer@127.0.0.1:5435/xreviewer

# Redis
REDIS_URL=redis://127.0.0.1:6382

# API
API_HOST=0.0.0.0
NODE_ENV=development

# Nuxt public
NUXT_PUBLIC_API_BASE=http://127.0.0.1:3712
NUXT_PUBLIC_DASHBOARD_URL=http://127.0.0.1:3711
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3710
# false on staging/local; true only when ready for Google/Yandex
NUXT_PUBLIC_ALLOW_INDEXING=false

# Optional Cloudflare cache purge on publish (SEO pipeline)
# CF_ZONE_ID=
# CF_API_TOKEN=

