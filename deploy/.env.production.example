# Copy to /var/www/dfijdsif/.env on the server (not committed)

DATABASE_URL=postgresql://ssaudit6202:CHANGE_ME@host.docker.internal:5432/ssaudit

NUXT_PUBLIC_SITE_URL=https://dfijdsif.website
NUXT_PUBLIC_API_BASE=https://dfijdsif.website
NUXT_PUBLIC_DASHBOARD_URL=https://dfijdsif.website
NUXT_PUBLIC_ALLOW_INDEXING=false

