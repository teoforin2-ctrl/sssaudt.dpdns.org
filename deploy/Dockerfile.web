# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NODE_OPTIONS=--max-old-space-size=3072
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY apps/dashboard/package.json apps/dashboard/

RUN pnpm install --frozen-lockfile --filter @x-reviewer/shared --filter @x-reviewer/web...

COPY packages/shared packages/shared
COPY apps/web apps/web

ARG NUXT_PUBLIC_API_BASE=https://dfijdsif.website
ARG NUXT_PUBLIC_SITE_URL=https://dfijdsif.website
ARG NUXT_PUBLIC_DASHBOARD_URL=https://dfijdsif.website
ARG NUXT_PUBLIC_ALLOW_INDEXING=false
ENV NUXT_PUBLIC_API_BASE=$NUXT_PUBLIC_API_BASE \
    NUXT_PUBLIC_SITE_URL=$NUXT_PUBLIC_SITE_URL \
    NUXT_PUBLIC_DASHBOARD_URL=$NUXT_PUBLIC_DASHBOARD_URL \
    NUXT_PUBLIC_ALLOW_INDEXING=$NUXT_PUBLIC_ALLOW_INDEXING

RUN pnpm --filter @x-reviewer/shared build \
 && pnpm --filter @x-reviewer/web build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 NITRO_HOST=0.0.0.0 NITRO_PORT=3000
COPY --from=build /app/apps/web/.output ./.output
EXPOSE 3000
USER node
CMD ["node", ".output/server/index.mjs"]
